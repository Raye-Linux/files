#: src/raye/archive/archiveentry.cpp:20
#, kde-format
msgctxt "@info"
msgid ""
"Files can't open this archive. It may have been moved, or you don't have "
"permission to open it."
msgstr ""
"Fichiers ne peut pas ouvrir cette archive. Elle a peut-être été déplacée, ou "
"vous n'avez pas l'autorisation de l'ouvrir."

#: src/raye/archive/archiveentry.cpp:22
#, kde-format
msgctxt "@info"
msgid ""
"Files can't open this file. It isn't a compressed folder, or it uses a "
"format Files can't read."
msgstr ""
"Fichiers ne peut pas ouvrir ce fichier. Ce n'est pas un dossier compressé, "
"ou son format n'est pas pris en charge."

#: src/raye/archive/archiveentry.cpp:24
#, kde-format
msgctxt "@info"
msgid "This compressed folder is damaged or incomplete."
msgstr "Ce dossier compressé est endommagé ou incomplet."

#: src/raye/archive/archiveentry.cpp:26
#: src/raye/qml/archive/ArchivePasswordPage.qml:40
#, kde-format
msgctxt "@info"
msgid "This archive is protected. Enter the password."
msgstr "Cette archive est protégée. Entrez le mot de passe."

#: src/raye/archive/archiveentry.cpp:28
#: src/raye/qml/archive/ArchivePasswordPage.qml:64
#, kde-format
msgctxt "@info"
msgid "The password is incorrect. Try again."
msgstr "Le mot de passe est incorrect. Réessayez."

#: src/raye/archive/archiveentry.cpp:30
#, kde-format
msgctxt "@info"
msgid ""
"This archive can't be extracted safely. It tries to put files outside the "
"destination folder."
msgstr ""
"Cette archive ne peut pas être extraite en toute sécurité. Elle tente de "
"placer des fichiers en dehors du dossier de destination."

#: src/raye/archive/archiveentry.cpp:32
#, kde-format
msgctxt "@info"
msgid ""
"This archive expands to much more than its size. Extracting it could fill "
"your drive."
msgstr ""
"Cette archive occupe beaucoup plus de place une fois extraite. L'extraire "
"pourrait remplir votre lecteur."

#: src/raye/archive/archiveentry.cpp:34
#, kde-format
msgctxt "@info"
msgid "The operation was canceled."
msgstr "L'opération a été annulée."

#: src/raye/archive/archiveentry.cpp:36
#, kde-format
msgctxt "@info"
msgid ""
"Files can't write here. The drive may be full, or you don't have permission."
msgstr ""
"Fichiers ne peut pas écrire ici. Le lecteur est peut-être plein, ou vous "
"n'avez pas l'autorisation."

#: src/raye/archive/archiveentry.cpp:38
#, kde-format
msgctxt "@info"
msgid "This item isn't in the archive any more."
msgstr "Cet élément ne se trouve plus dans l'archive."

#: src/raye/archive/archiveentry.cpp:40
#, kde-format
msgctxt "@info"
msgid "Files can't do this with this kind of archive."
msgstr "Fichiers ne peut pas faire cela avec ce type d'archive."

#: src/raye/archive/archiveentry.cpp:42
#, kde-format
msgctxt "@info"
msgid ""
"A part of this archive is missing. Put all its parts in the same folder and "
"try again."
msgstr ""
"Il manque une partie de cette archive. Mettez toutes ses parties dans le "
"même dossier, puis réessayez."

#: src/raye/archive/archiveformat.cpp:196
#, kde-format
msgctxt "@info"
msgid "Files can't add to this archive."
msgstr "Fichiers ne peut pas ajouter d'éléments à cette archive."

