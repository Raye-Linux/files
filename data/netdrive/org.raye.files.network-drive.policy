<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Map network drive. The helper only mounts a share on an empty folder
     the caller owns in their home (or /media/<login>), as that user, with
     nosuid and nodev: no more than udisks lets anyone at the screen do. -->
<policyconfig>
  <vendor>Raye</vendor>
  <action id="org.raye.files.network-drive">
    <description>Connect and disconnect network drives</description>
    <description xml:lang="fr">Connecter et déconnecter des lecteurs réseau</description>
    <message>Authentication is required to connect a network drive</message>
    <message xml:lang="fr">Une authentification est nécessaire pour connecter un lecteur réseau</message>
    <icon_name>folder-network</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@RAYE_LIBEXEC@/raye-files-netdrive-helper</annotate>
  </action>
</policyconfig>
